# ============================================================
# Copy file này thành .env.local và điền giá trị thật vào
# KHÔNG commit file .env.local lên git
# ============================================================

# --- Supabase (Frontend - chỉ dùng anon key cho client SDK nếu cần) ---
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase (Backend API - service role key, không expose ra frontend) ---
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Auth ---
APP_SHARED_PASSWORD=<mật-khẩu-chung-của-app>
SESSION_SECRET=<chuỗi-ngẫu-nhiên-dài-ít-nhất-32-ký-tự>

# Bypass auth trong môi trường local dev (chỉ frontend)
# VITE_SKIP_AUTH=true

# Dùng mock data local (CRUD quà qua localStorage, không cần API backend)
# VITE_USE_MOCK_DATA=true
